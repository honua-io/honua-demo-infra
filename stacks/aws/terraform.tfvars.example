# Copy to terraform.tfvars and fill in real values.
# NEVER commit terraform.tfvars — it contains secrets.

region      = "us-west-2"
environment = "demo"
name_prefix = "honua-demo"

# Mandatory Metadata v2 environment served by the live Lambda. Source this from
# Metadata__Environment / Environment or the active metadata_v2_current row;
# never infer it from ASPNETCORE_ENVIRONMENT.
stac_seed_metadata_environment = "default"

# Lambda AOT image — pin to an immutable release tag or digest from ECR.
# The image MUST be pushed to ECR before apply (Lambda requires ECR; GHCR is
# not supported directly by Lambda). Push the ghcr.io image to your ECR repo.
# Example after push:
#   honua_image = "123456789012.dkr.ecr.us-west-2.amazonaws.com/honua-server:v1.5.0-lambda-aot"
honua_image = "123456789012.dkr.ecr.us-west-2.amazonaws.com/honua-server:v1.5.0-lambda-aot"

# Minimum 32 characters — also used as Security__ConnectionEncryption__MasterKey.
# Generate: openssl rand -hex 32
honua_admin_password = "REPLACE_WITH_STRONG_SECRET_MIN_32_CHARS"

# Leave null to let Terraform auto-generate a secure password.
# db_password = null

# RDS size. db.t4g.small is the public-demo reliability floor after a real
# Console browser run exhausted db.t4g.micro's usable connection slots.
# db_instance_class = "db.t4g.small"

# Cost controls: fck-nat instance size and the monthly budget alarm.
# nat_instance_type         = "t4g.nano"
# monthly_budget_amount     = 150
# budget_notification_email = "mike@honua.io"

# Route53 hosted zone ID for the zone that owns demo.honua.io.
# See README.md — DNS prerequisites for the required hosted zone setup.
route53_zone_id = "ZXXXXXXXXXXXXXXXXX"

# Lambda memory (MB). 1024 is the module default and sensible for demo traffic.
# Cold starts are acceptable for a demo; the AOT image keeps them short.
# lambda_memory_size = 1024

# API Gateway throttle limits. Replaces WAF (HTTP API does not support WAFv2).
# api_throttle_burst_limit = 200   # concurrent burst
# api_throttle_rate_limit  = 50    # requests/second steady state

# ---------------------------------------------------------------------------
# Pro + AI demo add-ons (all OFF by default). The live demo.honua.io runs
# these ON; see README → "Pro + AI demo drift" for the terraform import
# sequence that adopts the already-live resources before any plan/apply.
# ---------------------------------------------------------------------------

# Redis — in-VPC ElastiCache. KEEP OFF for now: the aws-serverless module wires
# ConnectionStrings__redis as an aws:secretsmanager: reference, but honua-server
# resolves such references only for the Postgres connection, not for Redis
# (Program.cs feeds the raw value to StackExchange's ConfigurationOptions.Parse) —
# a version deployed with this ON crash-loops at startup ("Redis durable
# coordination is required..."). Re-enable once honua-server supports secret
# references for the Redis connection string (tracked in the server repo) or the
# module gains an inline-string mode. The live env has never had Redis wired.
# enable_redis    = true
# redis_node_type = "cache.t3.micro"

# Pro license via Secrets Manager. This is the ONLY line needed: the signed
# envelope is staged out-of-band in Secrets Manager and adopted by ARN
# (pro_license_secret_arn defaults to the live demo secret in variables.tf), and
# the trusted PUBLIC key is a plain default there too — a public key verifies a
# signature, it cannot mint a license, so it is not a secret.
#
# Do NOT set pro_license_content here. It is an escape hatch for callers who want
# Terraform to own the envelope; supplying it alongside pro_license_secret_arn is
# rejected by a module precondition, and it would write a signed license into
# tfvars and state — exactly what adopt-by-ARN exists to prevent.
# enable_pro_license = true

# Bedrock AI (WorkflowGeneration). Least-privilege InvokeModel grant; Bedrock
# is reached via the fck-nat egress (nat-instance.tf). Keep bedrock_ai_region
# equal to region (the VPC's region).
# enable_bedrock_ai = true
# bedrock_ai_model  = "us.anthropic.claude-sonnet-4-5-20250929-v1:0"
# bedrock_ai_region = "us-west-2"

# Studio AI proxy (live Studio AI generation, honua-server#3000; demo issue #9).
# Independent toggle/model/IAM grant from enable_bedrock_ai; Bedrock is
# reached via the fck-nat egress (nat-instance.tf). Keep studio_ai_region
# equal to region (the VPC's region). Default model is the cross-region Claude Opus 5
# inference profile (agreement accepted 2026-07-24; entitlement can lag — run
# the runbook smoke first). The IAM grant also covers studio_ai_fallback_models
# (default: the verified Sonnet 4.6 profile), so studio_ai_model can be
# flipped between them without an IAM change — see the runbook.
# enable_studio_ai = true
# studio_ai_model  = "us.anthropic.claude-opus-5"
# studio_ai_fallback_models = ["us.anthropic.claude-sonnet-4-6"]
# studio_ai_region = "us-west-2"

tags = {
  Owner      = "platform"
  CostCentre = "demo"
}
