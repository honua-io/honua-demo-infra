{
  "comment": "Every Terraform root under stacks/ and how the nightly drift plan (.github/workflows/drift-plan.yml) and the PR plan/apply workflow (.github/workflows/terraform.yml) treat it. scripts/drift-stacks.py refuses a stacks/ directory that is not listed here. A standing entry tolerates ONE exact provider artifact and must link the issue that removes it.",
  "stacks": {
    "aws": {
      "deployed": true,
      "state_key": "demo/aws-demo/terraform.tfstate",
      "var_file": "demo.tfvars",
      "admin_password": true,
      "prebuild": [
        "python3 stacks/aws/postgis-bootstrap/build.py --check"
      ],
      "standing": [
        {
          "address": "module.honua.module.rds[0].module.db_parameter_group.aws_db_parameter_group.this[0]",
          "actions": [
            "update"
          ],
          "attribute": "parameter",
          "before": [
            {
              "apply_method": "pending-reboot",
              "name": "rds.force_ssl",
              "value": "1"
            }
          ],
          "after": [
            {
              "apply_method": "immediate",
              "name": "rds.force_ssl",
              "value": "1"
            }
          ],
          "issue": "https://github.com/honua-io/honua-iac/issues/321"
        }
      ]
    },
    "aws-candidate-preflight": {
      "deployed": true,
      "state_key": "demo/aws-demo/candidate-preflight.tfstate",
      "prebuild": [],
      "standing": []
    },
    "aws-db-migration-runner": {
      "deployed": true,
      "state_key": "demo/aws-demo/db-migration-runner.tfstate",
      "apply_note": "Applied only through scripts/db-migration-runner-plan-apply.sh (saved, reviewed plan); runtime invocation is a separate gate. The 574c804 runner was applied 2026-10-27 (#108).",
      "prebuild": [
        "python3 stacks/aws-db-migration-runner/runner/build.py --source stacks/aws-db-migration-runner/runner --output stacks/aws-db-migration-runner/db-migration-runner.zip && test \"$(sha256sum stacks/aws-db-migration-runner/db-migration-runner.zip | cut -d' ' -f1)\" = \"$(sed -n 's/^readonly ARCHIVE_SHA256=\"\\([0-9a-f]*\\)\"$/\\1/p' scripts/db-migration-runner-plan-apply.sh)\""
      ],
      "standing": []
    }
  }
}
